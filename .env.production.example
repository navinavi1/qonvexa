NODE_ENV=production
PORT=3000
LAUNCH_MODE=staging
SITE_URL=https://qonvexa.co

AUDIT_PRICE_CENTS=14900

# Production identity / legal values (required when NODE_ENV=production)
CONTACT_EMAIL=
LEGAL_BUSINESS_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=2026-08-19
DELIVERY_TIMEFRAME=
REFUND_POLICY_TEXT=

# Persistence: production host should mount this on persistent storage
STORAGE_DIR=/var/lib/qonvexa/data

# Privacy / abuse protection
IP_HASH_SALT=

# Optional: POST preview_request / paid_order JSON to Make, Zapier, n8n, etc.
NOTIFICATION_WEBHOOK_URL=

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Domain email preparation (wire to your email provider after domain setup)
DOMAIN_EMAIL_FROM=
DOMAIN_EMAIL_REPLY_TO=

# Payment safety: disabled by default in staging.
ALLOW_STAGING_PAYMENTS=false


# ── AutonomOS 3 platform layer (all optional; dashboard shows what is missing) ──
# Cache / distributed locks
# Multi-model gateway. If set, this takes precedence over AUTONOMOS_LLM_BASE_URL.
# Optional extra domains browser tasks may navigate to (comma-separated).
# S3-compatible artifact storage
# Observability
# External review / identity (wired as optional infrastructure; activation requires account setup)
# Payout routing. Intermediaries MUST be manually verified for Ukrainian FOP support before adding.
# E2B expanded shell execution
# Optional deploy adapter stays OFF until a specific allowlisted deploy endpoint is configured.

# Broad authenticated app tool gateway (Composio; scoped project key recommended)
# Optional comma-separated toolkit allowlist. Empty = all non-financial/non-destructive toolkits.
# Extra toolkit denylist in addition to built-in financial/destructive blocks.


# Optional centralized secret bundle (JSON object in AWS Secrets Manager).
# Explicit Render environment variables always win over values from the bundle.
# Optional multi-currency FOP accounts. Each object: beneficiary, bank, iban, swift, currency, note.

# ── AutonomOS current production stack (2026-09) ──
# Runtime master switch / owner identity

# LLM / OpenAI Agents SDK. OPENAI_API_KEY is required by the official Agents SDK planner.
OPENAI_BASE_URL=https://api.openai.com/v1


# Code execution / build sandbox

TRIGGER_API_URL=https://api.trigger.dev

# Composio connected apps. If every toolkit has exactly one active account, the runtime
# resolves it automatically. Use this map only when a toolkit has multiple active accounts.

# GitHub direct PR tool. Optional guard: set the login that GITHUB_TOKEN MUST belong to.

# Browser / artifacts

# Memory / embeddings

CLAWLANCER_API_KEY=
CLAWLANCER_AGENT_ID=
DEALWORK_API_KEY=

# Optional direct bank payout fallback
MANUAL_PAYMENT_ENABLED=false
PAYMENT_MODE=
BANK_BENEFICIARY=
BANK_NAME=
BANK_IBAN=
BANK_SWIFT=
BANK_ACCOUNT=
BANK_CURRENCY=
BANK_PAYMENT_NOTE=

# QA / procurement safety

# Render supplies these automatically when applicable; do not hand-copy them between services.
# RENDER_EXTERNAL_URL=
# RENDER_GIT_COMMIT=


# Future deployment requires staging acceptance; this is not deployment authorization.
QONVEXA_NEW_AUDIT_ENGINE=true
QONVEXA_IMPLEMENTATIONS=true
QONVEXA_CRM_CONNECTORS=false
QONVEXA_OUTREACH=false
QONVEXA_AI_VISIBILITY=true
QONVEXA_PUBLIC_FETCH_ENABLED=false
QONVEXA_PAYMENTS_ENABLED=false
QONVEXA_OUTBOUND_ENABLED=false
IMPLEMENTATION_DRY_RUN=true
OUTREACH_DRY_RUN=true
QONVEXA_CONNECTION_KEY=
# Legacy workers are never loaded by the Qonvexa runtime.
AUTONOMOS_ENABLED=false
