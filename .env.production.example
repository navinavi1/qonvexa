NODE_ENV=production
LAUNCH_MODE=staging
PORT=3000
# Leave SITE_URL empty on the first Render deploy to use RENDER_EXTERNAL_URL automatically.
# After qonvexa.co is connected, set SITE_URL=https://qonvexa.co
SITE_URL=

# Stripe: test keys are allowed in staging. Switch LAUNCH_MODE=live only after live keys are installed.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
AUDIT_PRICE_CENTS=14900

# Business / legal — required only when LAUNCH_MODE=live
CONTACT_EMAIL=
LEGAL_BUSINESS_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=2026-08-19
DELIVERY_TIMEFRAME=
REFUND_POLICY_TEXT=

# Render persistent disk
STORAGE_DIR=/var/lib/qonvexa/data

# Security
IP_HASH_SALT=REPLACE_WITH_24_PLUS_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_14_PLUS_CHARACTER_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# Optional notifications (Make / Zapier / n8n)
NOTIFICATION_WEBHOOK_URL=

# Domain email preparation
DOMAIN_EMAIL_FROM=
DOMAIN_EMAIL_REPLY_TO=

# Payment safety: disabled by default in staging.
ALLOW_STAGING_PAYMENTS=false

# t2000 Passport Connect: browser OAuth stores the delegated session under STORAGE_DIR.
# No T2000_SESSION_TOKEN / API key is copied into Render manually.
T2000_MCP_URL=https://mcp.t2000.ai/mcp
