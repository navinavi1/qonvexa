NODE_ENV=production
PORT=3000
LAUNCH_MODE=staging
SITE_URL=https://qonvexa.co

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AUDIT_PRICE_CENTS=14900

# Production identity / legal values (required when NODE_ENV=production)
CONTACT_EMAIL=
LEGAL_BUSINESS_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=2026-08-19
DELIVERY_TIMEFRAME=
REFUND_POLICY_TEXT=

# Persistence: production host should mount this on persistent storage
STORAGE_DIR=/var/lib/qonvexa/data

# Privacy / abuse protection
IP_HASH_SALT=

# Optional: POST preview_request / paid_order JSON to Make, Zapier, n8n, etc.
NOTIFICATION_WEBHOOK_URL=

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Domain email preparation (wire to your email provider after domain setup)
DOMAIN_EMAIL_FROM=
DOMAIN_EMAIL_REPLY_TO=

# Payment safety: disabled by default in staging.
ALLOW_STAGING_PAYMENTS=false

# t2000 Passport Connect: browser OAuth stores the delegated session under STORAGE_DIR.
# No T2000_SESSION_TOKEN / API key is copied into Render manually.
T2000_MCP_URL=https://mcp.t2000.ai/mcp

# ── AutonomOS 3 platform layer (all optional; dashboard shows what is missing) ──
# Durable operational DB + long-term vector memory
DATABASE_URL=
# Cache / distributed locks
REDIS_URL=
# Event bus
NATS_URL=
# Durable workflows (run a separate Temporal service/worker)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS=false
# Multi-model gateway. If set, this takes precedence over AUTONOMOS_LLM_BASE_URL.
LITELLM_BASE_URL=
LITELLM_API_KEY=
AUTONOMOS_MODEL_ROUTING_JSON={}
# Browser automation (Stagehand + Browserbase)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Optional extra domains browser tasks may navigate to (comma-separated).
AUTONOMOS_BROWSER_ALLOWED_DOMAINS=
STAGEHAND_MODEL=
# S3-compatible artifact storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
OPENSEARCH_URL=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# External review / identity (wired as optional infrastructure; activation requires account setup)
CODERABBIT_API_KEY=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Payout routing. Intermediaries MUST be manually verified for Ukrainian FOP support before adding.
AUTONOMOS_PAYOUT_NETWORKS_JSON=["base"]
AUTONOMOS_PAYOUT_CRYPTO_JSON=["USDC","USDT"]
AUTONOMOS_VERIFIED_PAYOUT_INTERMEDIARIES_JSON=[]
# E2B expanded shell execution
AUTONOMOS_E2B_SHELL_COST_USD=0.03
AUTONOMOS_E2B_COMMAND_TIMEOUT_MS=60000
AUTONOMOS_BROWSER_TASK_COST_USD=0.05
# Optional deploy adapter stays OFF until a specific allowlisted deploy endpoint is configured.
AUTONOMOS_DEPLOY_WEBHOOK_URL=

# Broad authenticated app tool gateway (Composio; scoped project key recommended)
COMPOSIO_API_KEY=
# Optional comma-separated toolkit allowlist. Empty = all non-financial/non-destructive toolkits.
AUTONOMOS_COMPOSIO_ALLOW_TOOLKITS=
# Extra toolkit denylist in addition to built-in financial/destructive blocks.
AUTONOMOS_COMPOSIO_DENY_TOOLKITS=
AUTONOMOS_COMPOSIO_TOOL_COST_USD=0.01

# Temporal paid-job durability. Run `npm run autonomos-temporal-worker` as a separate worker service.
TEMPORAL_TASK_QUEUE=autonomos-paid-jobs
AUTONOMOS_TEMPORAL_WORKER_TOKEN=
AUTONOMOS_INTERNAL_BASE_URL=

# Optional centralized secret bundle (JSON object in AWS Secrets Manager).
# Explicit Render environment variables always win over values from the bundle.
AUTONOMOS_AWS_SECRET_ID=
AUTONOMOS_SECRETS_REQUIRED=false
AWS_REGION=
# Optional multi-currency FOP accounts. Each object: beneficiary, bank, iban, swift, currency, note.
# Legacy BANK_* values remain supported as one account.
AUTONOMOS_FOP_ACCOUNTS_JSON=[]
# Marketplace payout capabilities, e.g. {"market":["swift","crypto"]}; only use verified facts.
AUTONOMOS_MARKET_PAYOUT_METHODS_JSON={}

# ── AutonomOS current production stack (2026-09) ──
# Runtime master switch / owner identity
AUTONOMOS_ENABLED=false
AUTONOMOS_AGENT_NAME=AutonomOS
AUTONOMOS_OWNER_WALLET=

# LLM / OpenAI Agents SDK. OPENAI_API_KEY is required by the official Agents SDK planner.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AUTONOMOS_LLM_API_KEY=
AUTONOMOS_LLM_BASE_URL=https://api.openai.com/v1
AUTONOMOS_LLM_MODEL=
AUTONOMOS_USE_OPENAI_AGENTS_SDK=true
AUTONOMOS_LLM_INPUT_USD_PER_MILLION=
AUTONOMOS_LLM_OUTPUT_USD_PER_MILLION=
AUTONOMOS_MAX_TOOL_ROUNDS=8

# Web research: Tavily is primary search; Firecrawl remains deep scrape/crawl fallback.
TAVILY_API_KEY=
AUTONOMOS_TAVILY_SEARCH_COST_USD=0
AUTONOMOS_WEB_SEARCH_COST_USD=0
FIRECRAWL_API_KEY=
AUTONOMOS_FIRECRAWL_SEARCH_COST_USD=0
AUTONOMOS_FIRECRAWL_SCRAPE_COST_USD=0

# Code execution / build sandbox
E2B_API_KEY=
AUTONOMOS_E2B_SANDBOX_COST_USD=0

# Durable paid-job dispatch. Trigger.dev is the current provider.
TRIGGER_SECRET_KEY=
AUTONOMOS_TRIGGER_TASK_ID=autonomos-paid-job
TRIGGER_API_URL=https://api.trigger.dev
# Only needed by the Trigger CLI when deploying tasks; copy the project ref from Trigger.dev.
TRIGGER_PROJECT_REF=

# Composio connected apps. If every toolkit has exactly one active account, the runtime
# resolves it automatically. Use this map only when a toolkit has multiple active accounts.
AUTONOMOS_COMPOSIO_ACCOUNTS_JSON={}
AUTONOMOS_COMPOSIO_SEARCH_COST_USD=0

# GitHub direct PR tool. Optional guard: set the login that GITHUB_TOKEN MUST belong to.
GITHUB_TOKEN=
AUTONOMOS_GITHUB_EXPECTED_LOGIN=

# Browser / artifacts
AUTONOMOS_ARTIFACT_MAX_BYTES=26214400
AUTONOMOS_ARTIFACT_URL_TTL_SECONDS=3600
AUTONOMOS_S3_PUT_COST_USD=0
S3_PUBLIC_BASE_URL=

# Memory / embeddings
AUTONOMOS_LANGGRAPH_SCHEMA=autonomos
AUTONOMOS_EMBEDDING_MODEL=text-embedding-3-small
AUTONOMOS_EMBEDDING_DIMENSIONS=1536
AUTONOMOS_MEMORY_RECALL_LIMIT=8

# Marketplace connectors / seller rails
CLAWLANCER_API_KEY=
CLAWLANCER_AGENT_ID=
DEALWORK_API_KEY=
T2000_DISCOVERY_LIMIT=100
T2000_OAUTH_STORAGE_SECRET=
AUTONOMOS_BAZAAR_URL=
AUTONOMOS_X402_ENABLED=false
AUTONOMOS_X402_FACILITATOR_URL=
AUTONOMOS_X402_FACILITATOR_HEADERS_JSON={}
AUTONOMOS_X402_ACCEPTS_JSON=[]

# Optional direct bank payout fallback
MANUAL_PAYMENT_ENABLED=false
PAYMENT_MODE=
BANK_BENEFICIARY=
BANK_NAME=
BANK_IBAN=
BANK_SWIFT=
BANK_ACCOUNT=
BANK_CURRENCY=
BANK_PAYMENT_NOTE=

# QA / procurement safety
AUTONOMOS_QA_FAIL_OPEN=false
AUTONOMOS_PAYOUT_VERIFICATION_MAX_AGE_DAYS=30
AUTONOMOS_CODERABBIT_COST_PER_FILE_USD=0
AUTONOMOS_CODERABBIT_MIN_JOB_USD=0
AUTONOMOS_CODERABBIT_TIMEOUT_MS=120000
AUTONOMOS_DEPLOY_WEBHOOK_TOKEN=

# Render supplies these automatically when applicable; do not hand-copy them between services.
# RENDER_EXTERNAL_URL=
# RENDER_GIT_COMMIT=
