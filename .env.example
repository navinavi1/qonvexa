NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

AUDIT_PRICE_CENTS=14900

# Production identity / legal values (required when NODE_ENV=production)
CONTACT_EMAIL=
LEGAL_BUSINESS_NAME=
LEGAL_ADDRESS=
LEGAL_JURISDICTION=
LEGAL_LAST_UPDATED=2026-09-25
DELIVERY_TIMEFRAME=
REFUND_POLICY_TEXT=

# Persistence: production host should mount this on persistent storage
STORAGE_DIR=./data

# Privacy / abuse protection
IP_HASH_SALT=replace-with-a-long-random-value

# Optional: POST preview_request / paid_order JSON to Make, Zapier, n8n, etc.
NOTIFICATION_WEBHOOK_URL=

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Domain email preparation (wire to your email provider after domain setup)
DOMAIN_EMAIL_FROM=
DOMAIN_EMAIL_REPLY_TO=

# Payment safety: disabled by default in staging.
ALLOW_STAGING_PAYMENTS=false


# Cache / distributed locks
# Multi-model gateway. If set, this takes precedence over AUTONOMOS_LLM_BASE_URL.
# Optional extra domains browser tasks may navigate to (comma-separated).
# S3-compatible artifact storage
# Observability
# External review / identity (wired as optional infrastructure; activation requires account setup)
# Payout routing. Intermediaries MUST be manually verified for Ukrainian FOP support before adding.
# E2B expanded shell execution
# Optional deploy adapter stays OFF until a specific allowlisted deploy endpoint is configured.

# Broad authenticated app tool gateway (Composio; scoped project key recommended)
# Optional comma-separated toolkit allowlist. Empty = all non-financial/non-destructive toolkits.
# Extra toolkit denylist in addition to built-in financial/destructive blocks.


# Optional centralized secret bundle (JSON object in AWS Secrets Manager).
# Explicit Render environment variables always win over values from the bundle.
# Optional multi-currency FOP accounts. Each object: beneficiary, bank, iban, swift, currency, note.

# ── AutonomOS current production stack (2026-09) ──
# Runtime master switch / owner identity
# the market-expansion registrar and the email lane but documented nowhere, so
# registrations were submitted with an empty email address.

# Payout destinations. The code supports three crypto slots but only the EVM one was ever
# documented, so the other two read as "not configured" with nothing to point at.
# AUTONOMOS_OWNER_WALLET is the EVM (Base/Ethereum/Arbitrum/Polygon) address and also the
# x402 payTo address.
# Solana. TaskForce settles USDC on Solana, so with this empty selectPayoutRoute() answers
# no_compatible_wallet_for_currency_or_network and the job is refused before it is claimed.

# The agents' working float is NOT an env var: it is config.seedSpendBudgetUsd, set from the
# admin dashboard and capped at $50 on purpose, because a seed is unearned spending. To add
# auditable owner_funding row in the ledger.

# LLM / OpenAI Agents SDK. OPENAI_API_KEY is required by the official Agents SDK planner.
OPENAI_BASE_URL=https://api.openai.com/v1


# Code execution / build sandbox

TRIGGER_API_URL=https://api.trigger.dev

# Composio connected apps. If every toolkit has exactly one active account, the runtime
# resolves it automatically. Use this map only when a toolkit has multiple active accounts.

# GitHub direct PR tool. Optional guard: set the login that GITHUB_TOKEN MUST belong to.

# Browser / artifacts

# Memory / embeddings

CLAWLANCER_API_KEY=
CLAWLANCER_AGENT_ID=
DEALWORK_API_KEY=

# Optional direct bank payout fallback

# QA / procurement safety

# Render supplies these automatically when applicable; do not hand-copy them between services.
# RENDER_EXTERNAL_URL=
# RENDER_GIT_COMMIT=


# Qonvexa Next: local-safe defaults; never put real credentials in this file.
QONVEXA_NEW_AUDIT_ENGINE=true
# Enables planning only. Live implementation is not shipped.
QONVEXA_IMPLEMENTATIONS=true
QONVEXA_CRM_CONNECTORS=false
QONVEXA_OUTREACH=false
QONVEXA_AI_VISIBILITY=true
# Public HTTP reads require an explicit opt-in. No automatic outbound requests.
QONVEXA_PUBLIC_FETCH_ENABLED=false
QONVEXA_PAYMENTS_ENABLED=false
QONVEXA_OUTBOUND_ENABLED=false
IMPLEMENTATION_DRY_RUN=true
OUTREACH_DRY_RUN=true
# Optional 32-byte hex key for adapter tests / future connector storage.
QONVEXA_CONNECTION_KEY=
QONVEXA_QUOTE_DAYS=14
QONVEXA_WARRANTY_DAYS=14
QONVEXA_RETENTION_DAYS=30
QONVEXA_DAILY_SCANS=25
QONVEXA_DAILY_DRAFTS=10
QONVEXA_FREE_COST_CAP=0.10
QONVEXA_AUDIT_COST_CAP=5
QONVEXA_SMALL_COST_CAP=20
QONVEXA_LARGE_COST_CAP=50
QONVEXA_WORKER_USD_PER_SECOND=0.00005

# Optional server-side price overrides in integer USD cents; blank means catalogue default.
# QONVEXA_PRICE_CONVERSION_CENTS=<positive integer>
# QONVEXA_PRICE_SEO_CENTS=<positive integer>
# QONVEXA_PRICE_SPEED_CENTS=<positive integer>
# QONVEXA_PRICE_SCHEMA_CENTS=<positive integer>
# QONVEXA_PRICE_ANALYTICS_CENTS=<positive integer>
# QONVEXA_PRICE_LOCAL_CENTS=<positive integer>
# QONVEXA_PRICE_CRM_CENTS=<positive integer>
# QONVEXA_PRICE_FOLLOWUP_CENTS=<positive integer>
# QONVEXA_PRICE_BOOKING_CENTS=<positive integer>
# QONVEXA_PRICE_ASSISTANT_CENTS=<positive integer>
# QONVEXA_PRICE_REPUTATION_CENTS=<positive integer>
# QONVEXA_PRICE_FULL_CENTS=<positive integer>

# Existing payment configuration, opt-in only. Blank account values are intentional.
LAUNCH_MODE=development
PAYMENT_MODE=manual
MANUAL_PAYMENT_ENABLED=false
BANK_BENEFICIARY=
BANK_NAME=
BANK_ACCOUNT=
BANK_IBAN=
BANK_SWIFT=
BANK_CURRENCY=USD
BANK_PAYMENT_NOTE=
# Legacy workers are never loaded by the Qonvexa runtime.
AUTONOMOS_ENABLED=false
